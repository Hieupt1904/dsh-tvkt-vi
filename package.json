{
  "name": "dsh-tvkt-vi",
  "version": "0.5.2",
  "description": "Chuẩn tiếng Việt kỹ thuật TVKT-100 cho DeepSeek Harness: hợp đồng system prompt cho mọi mode, skill tvkt-vi, linter L001-L007 và agent mode DRAFT/REVIEW/REWRITE.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./contract": "./lib/contract.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "docs",
    "skills",
    "vendor",
    "scripts",
    "icon.svg",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "check-drift": "node scripts/check-drift.mjs",
    "gen:terms": "node scripts/gen-terms-quick.mjs",
    "check:terms": "node scripts/gen-terms-quick.mjs --check",
    "lint:skill": "python3 skills/tvkt-vi/scripts/lint-text.py skills/tvkt-vi/SKILL.md --quiet",
    "lint:text": "python3 skills/tvkt-vi/scripts/lint-text.py",
    "cli:engine": "node scripts/check-engine.mjs",
    "cli:release": "node scripts/check-release.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm test && npm run lint:skill && npm run check-drift && npm run check:terms && python3 tests/golden/generate.py --check && npm run check:package && npm run cli:engine && npm run cli:release && npm run docs:verify && npm run bench",
    "compat:smoke": "node scripts/compat-smoke.mjs",
    "docs:impact": "node scripts/docs-impact.mjs",
    "docs:verify": "node scripts/docs-verify.mjs",
    "docs:sync": "node scripts/docs-sync.mjs",
    "bench": "python3 tests/bench/bench.py --compare"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vietnamese",
    "tieng-viet",
    "tvkt",
    "controlled-language",
    "ste100",
    "writing-standard",
    "linter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hieupt1904/dsh-tvkt-vi.git"
  },
  "homepage": "https://github.com/Hieupt1904/dsh-tvkt-vi#readme",
  "bugs": {
    "url": "https://github.com/Hieupt1904/dsh-tvkt-vi/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/Hieupt1904/dsh-tvkt-vi/releases/latest/download/dsh-tvkt-vi.tgz",
      "git": "https://github.com/Hieupt1904/dsh-tvkt-vi.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-0 <5.0.0-0"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.2 || 0.2.2-rc.5"
  },
  "dshTarget": "0.2.2-rc.5",
  "icon": "./icon.svg",
  "devDependencies": {
    "js-yaml": "^4.3.2"
  }
}
